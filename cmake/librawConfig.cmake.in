include(CMakeFindDependencyMacro)

if(@JASPER_FOUND@)
    find_dependency(Jasper)
endif()

if(@JPEG_FOUND@)
    find_dependency(JPEG)
endif()
if(@ZLIB_FOUND@)
    find_dependency(ZLIB)
endif()

if(@LCMS_SUPPORT_CAN_BE_COMPILED@)
    # find_dependency() returns early on failure. Use a function scope so the
    # private finder path cannot leak into the caller in that case either.
    function(_libraw_find_lcms_dependency)
        list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")
        if(@LCMS2_FOUND@)
            find_dependency(LCMS2)
        elseif(@LCMS_FOUND@)
            find_dependency(LCMS)
        endif()
        set(_libraw_lcms_dependency_found TRUE PARENT_SCOPE)
    endfunction()
    set(_libraw_lcms_dependency_found FALSE)
    _libraw_find_lcms_dependency()
    if(NOT _libraw_lcms_dependency_found)
        set(libraw_FOUND FALSE)
        set(libraw_NOT_FOUND_MESSAGE "The LCMS dependency required by libraw was not found")
        return()
    endif()
    unset(_libraw_lcms_dependency_found)
endif()

if(@ENABLE_DNGSDK@)
    find_dependency(dng_sdk CONFIG)
endif()

if(@ENABLE_RAWSPEED@)
    find_dependency(LibXml2)
    find_dependency(Threads)
endif()

if(@OPENMP_SUPPORT_CAN_BE_COMPILED@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()


@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components("@PROJECT_NAME@")
